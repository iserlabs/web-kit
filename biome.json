{
  "extends": ["./src/biome/biome.base.json"],
  "files": {
    "includes": [
      "**",
      "!**/*.css",
      "!src/email/specimen.mjs",
      "!src/email/specimen.d.mts",
      "!src/audits/v3/__fixtures__"
    ]
  },
  "linter": { "rules": { "correctness": { "noComponentHookFactories": "warn" } } },
  "overrides": [
    {
      "includes": ["src/audits/v3/**"],
      "linter": {
        "rules": {
          "performance": { "useDomNodeTextContent": "off" },
          "style": { "useTemplate": "off" },
          "correctness": { "noUnusedFunctionParameters": "off" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    }
  ]
}
